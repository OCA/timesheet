<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_analytic_line_tree" model="ir.ui.view">
        <field name="model">account.analytic.line</field>
        <field
            name="inherit_id"
            ref="hr_timesheet_time_control.account_analytic_line_tree"
        />
        <field name="arch" type="xml">
            <field name="date" position="attributes">
                <attribute name="column_invisible">0</attribute>
                <attribute name="optional">show</attribute>
            </field>
            <field name="date_time" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="date_time_end" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="unit_amount" position="before">
                <field
                    name="time_begin"
                    widget="float_time"
                    optional="show"
                    readonly="readonly_timesheet"
                />
                <field
                    name="time_end"
                    widget="float_time"
                    optional="show"
                    readonly="readonly_timesheet"
                />
            </field>
        </field>
    </record>
    <record id="hr_timesheet_line_form" model="ir.ui.view">
        <field name="name">account.analytic.line.form.inherit</field>
        <field name="model">account.analytic.line</field>
        <field
            name="inherit_id"
            ref="hr_timesheet_time_control.hr_timesheet_line_form"
        />
        <field name="arch" type="xml">
            <field name="date" position="attributes">
                <attribute name="invisible">0</attribute>
            </field>
            <field name="date_time" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="date_time_end" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="unit_amount" position="before">
                <field
                    name="time_begin"
                    widget="float_time"
                    optional="show"
                    readonly="readonly_timesheet"
                />
                <field
                    name="time_end"
                    widget="float_time"
                    optional="show"
                    readonly="readonly_timesheet"
                />
            </field>
        </field>
    </record>
</odoo>
