<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_task_form2_inherited" model="ir.ui.view">
        <field name="name">Add timesheet time controls begin/end</field>
        <field name="model">project.task</field>
        <field
            name="inherit_id"
            ref="hr_timesheet_time_control.view_task_form2_inherited"
        />
        <field name="arch" type="xml">
            <!-- Sub-tree view for timesheet_ids -->
            <xpath
                expr="//field[@name='timesheet_ids']/list/field[@name='date']"
                position="attributes"
            >
                <attribute name="column_invisible">0</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath
                expr="//field[@name='timesheet_ids']/list/field[@name='date_time']"
                position="attributes"
            >
                <attribute name="optional">hide</attribute>
                <attribute name="string">Date Begin</attribute>
            </xpath>
            <xpath
                expr="//field[@name='timesheet_ids']/list/field[@name='unit_amount']"
                position="before"
            >
                <field
                    name="time_begin"
                    widget="float_time"
                    optional="show"
                    readonly="readonly_timesheet"
                />
                <field
                    name="time_end"
                    widget="float_time"
                    optional="show"
                    readonly="readonly_timesheet"
                />
            </xpath>
            <!-- Sub-kanban view for timesheet_ids -->
            <xpath
                expr="//field[@name='timesheet_ids']/kanban//*[@name='date']"
                position="attributes"
            >
                <attribute name="invisible">0</attribute>
            </xpath>
            <xpath
                expr="//field[@name='timesheet_ids']/kanban//*[@name='date_time']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
                expr="//field[@name='timesheet_ids']/kanban//*[@name='unit_amount']"
                position="before"
            >
                <field name="time_begin" widget="float_time" />
                <field name="time_end" widget="float_time" />
            </xpath>
            <!-- Sub-form view for timesheet_ids -->
            <xpath
                expr="//field[@name='timesheet_ids']/form//field[@name='date']"
                position="attributes"
            >
                <attribute name="invisible">0</attribute>
            </xpath>
            <xpath
                expr="//field[@name='timesheet_ids']/form//field[@name='date_time']"
                position="attributes"
            >
                <field name="date_time" invisible="1" />
            </xpath>
        </field>
    </record>
</odoo>
