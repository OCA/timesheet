<odoo>
    <record id="account_analytic_line_rule_portal_project_visibility" model="ir.rule">
        <field name="name">Timesheets of projects hidden from the portal</field>
        <field name="model_id" ref="analytic.model_account_analytic_line" />
        <field name="domain_force">[
            '|', '|',
            ('project_id', '=', False),
            ('project_id.show_timesheets_in_portal', '=', True),
            ('user_id', '=', user.id),
        ] if user.share else []</field>
    </record>
</odoo>
