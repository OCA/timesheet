<odoo>
    <template
        id="portal_my_timesheets_inherit_sale_timesheet_begin_end"
        inherit_id="sale_timesheet.portal_my_timesheets_inherit"
    >
        <xpath
            expr="//t[@t-elif=&quot;groupby == 'so_line'&quot;]//th"
            position="attributes"
        >
            <attribute name="t-att-colspan">7</attribute>
        </xpath>
        <xpath
            expr="//t[@t-elif=&quot;groupby == 'order_id'&quot;]//th"
            position="attributes"
        >
            <attribute name="t-att-colspan">8</attribute>
        </xpath>
        <xpath
            expr="//t[@t-elif=&quot;groupby == 'timesheet_invoice_id'&quot;]//th"
            position="attributes"
        >
            <attribute name="t-att-colspan">8</attribute>
        </xpath>
    </template>
</odoo>
