<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_timesheet_sheet_form" model="ir.ui.view">
        <field name="name">hr_timesheet.sheet.form.prefill</field>
        <field name="model">hr_timesheet.sheet</field>
        <field name="inherit_id" ref="hr_timesheet_sheet.hr_timesheet_sheet_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//header/button[@name='action_timesheet_confirm']"
                position="before"
            >
                <button
                    name="action_prefill_from_previous"
                    string="Prefill from Previous Period"
                    type="object"
                    invisible="state not in ('new', 'draft')"
                />
            </xpath>
        </field>
    </record>
</odoo>
