<odoo>
    <record id="hr_holiday_status_view_form_inherit" model="ir.ui.view">
        <field
            name="name"
        >hr.leave.type.form (in project_timesheet_holidays_edit_ts)</field>
        <field name="model">hr.leave.type</field>
        <field
            name="inherit_id"
            ref="project_timesheet_holidays.hr_holiday_status_view_form_inherit"
        />
        <field name="arch" type="xml">
            <field name="timesheet_task_id" position="after">
                <field
                    name="timesheet_edit_level"
                    required="timesheet_project_id"
                    invisible="not timesheet_generate"
                    widget="radio"
                    options="{'horizontal': true}"
                />
            </field>
        </field>
    </record>
</odoo>
