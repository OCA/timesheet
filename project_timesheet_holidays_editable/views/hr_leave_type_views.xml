<odoo>
    <record id="hr_holiday_status_view_form_inherit" model="ir.ui.view">
        <field
            name="name"
        >hr.leave.type.form (in project_timesheet_holidays_edit_ts)</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form" />
        <field name="arch" type="xml">
            <field name="time_type" position="after">
                <field
                    name="timesheet_edit_level"
                    invisible="time_type == 'other'"
                    widget="radio"
                    options="{'horizontal': true}"
                />
            </field>
        </field>
    </record>
</odoo>
