<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_timesheet_line_tree_break" model="ir.ui.view">
        <field name="name">account.analytic.line.tree.break</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="hr_timesheet_begin_end.hr_timesheet_line_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='time_stop']" position="after">
                <field
                    name="break_duration"
                    widget="float_time"
                    optional="show"
                    string="Break"
                />
            </xpath>
        </field>
    </record>

    <record id="hr_timesheet_line_form_break" model="ir.ui.view">
        <field name="name">account.analytic.line.form.break</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="hr_timesheet_begin_end.hr_timesheet_line_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='time_stop']" position="after">
                <field name="break_duration" widget="float_time" string="Break" />
            </xpath>
        </field>
    </record>
</odoo>
