<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Both -->
    <record id="crm_lead_view_form" model="ir.ui.view">
        <field name="name">CRM - Leads with timesheets</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">
            <!-- New fields -->
            <field name="user_id" position="after">
                <field name="project_id" invisible="1" />
                <field
                    name="project_id"
                    groups="hr_timesheet.group_hr_timesheet_user"
                    domain="[('allow_timesheets', '=', True), ('company_id', 'in', [False, company_id])]"
                />
                <field
                    name="total_time_spent"
                    widget="float_time"
                    groups="hr_timesheet.group_hr_timesheet_user"
                />
            </field>
            <page name="extra" position="after">
                <page
                    name="page_timesheets"
                    string="Timesheets"
                    groups="hr_timesheet.group_hr_timesheet_user"
                >
                    <field
                        name="timesheet_ids"
                        mode="list,kanban"
                        context="{'default_project_id': project_id, 'default_name': ''}"
                    >
                        <list editable="top" string="Timesheet Activities">
                            <field name="date" />
                            <field name="user_id" column_invisible="True" />
                            <field
                                name="employee_id"
                                widget="many2one_avatar_employee"
                                context="{'active_test': True}"
                                required="1"
                            />
                            <field name="project_id" required="True" optional="hide" />
                            <field name="name" string="Description" required="0" />
                            <field
                                name="unit_amount"
                                string="Time Spent"
                                widget="timesheet_uom"
                                decoration-danger="unit_amount &gt; 24 or unit_amount &lt; 0"
                            />
                            <field name="project_id" column_invisible="True" />
                            <field name="company_id" column_invisible="True" />
                        </list>
                        <kanban class="o_kanban_mobile">
                            <templates>
                                <t t-name="card">
                                    <div class="row">
                                        <div class="col-6 d-flex">
                                            <field
                                                name="employee_id"
                                                class="me-1"
                                                widget="many2one_avatar_employee"
                                                context="{'active_test': True}"
                                            />
                                            <field
                                                name="employee_id"
                                                class="ps-1 fw-bold"
                                            />
                                        </div>
                                        <field
                                            name="date"
                                            class="col-6 text-end fw-bold"
                                        />
                                    </div>
                                    <div class="row mt-2">
                                        <field
                                            name="name"
                                            class="col-8 text-muted"
                                            required="0"
                                        />
                                        <field
                                            name="unit_amount"
                                            widget="float_time"
                                            class="col-4 text-end fw-bold"
                                        />
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field
                            name="total_time_spent"
                            widget="timesheet_uom"
                            string="Total Time Spent"
                        />
                    </group>
                </page>
            </page>
        </field>
    </record>
    <!-- Leads -->
    <record id="crm_case_tree_view_leads" model="ir.ui.view">
        <field name="name">Add total time spent to lead tree</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads" />
        <field name="arch" type="xml">
            <list position="inside">
                <field
                    name="total_time_spent"
                    widget="float_time"
                    sum="Total"
                    optional="hide"
                    groups="hr_timesheet.group_hr_timesheet_user"
                />
            </list>
        </field>
    </record>
    <!-- Opportunities -->
    <record id="crm_case_tree_view_oppor" model="ir.ui.view">
        <field name="name">Add total time spent to opportunity tree</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor" />
        <field name="arch" type="xml">
            <list position="inside">
                <field
                    name="total_time_spent"
                    widget="float_time"
                    sum="Total"
                    optional="hide"
                    groups="hr_timesheet.group_hr_timesheet_user"
                />
            </list>
        </field>
    </record>
</odoo>
