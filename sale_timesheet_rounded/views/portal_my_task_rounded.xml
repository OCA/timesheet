<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="portal_my_task_rounded">
        <field name="name">portal_my_task_rounded</field>
        <field name="inherit_id" ref="hr_timesheet.portal_my_task" />
        <field name="arch" type="xml">
            <!-- Fix the 'Progress calculus' -->
            <xpath
                expr="//div[@name='portal_my_task_allocated_hours']/following-sibling::div[1]/span[@t-esc='task.progress * 100']"
                position="attributes"
            >
                <attribute name="t-esc" />
                <attribute name="t-out">
                    sum(task.timesheet_ids.mapped('unit_amount_rounded')) /
                    task.allocated_hours * 100
                </attribute>
            </xpath>
        </field>
    </record>
</odoo>
