<odoo>
    <template
        id="portal_my_task_amount_due_inherit"
        inherit_id="sale_timesheet.portal_my_task_inherit"
    >
        <xpath expr="//div[@name='amount_due']" position="attributes">
            <attribute name="t-if">
                task.sale_line_id.untaxed_amount_to_invoice &gt; 0 and task.show_amount_due
            </attribute>
        </xpath>
    </template>
</odoo>
