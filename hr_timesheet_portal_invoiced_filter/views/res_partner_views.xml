<odoo>
    <record id="res_partner_timesheet_portal_visibility_form" model="ir.ui.view">
        <field name="name">res.partner.timesheet.portal.visibility</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='accounting']" position="inside">
                <group>
                    <group string="Timesheet Portal Visibility">
                        <field
                            name="timesheet_portal_visibility"
                            invisible="commercial_partner_id != id"
                        />
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
