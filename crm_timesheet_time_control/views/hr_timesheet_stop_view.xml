<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_timesheet_stop_view_form" model="ir.ui.view">
        <field name="name">hr.timesheet.stop.form</field>
        <field name="model">hr.timesheet.stop</field>
        <field name="arch" type="xml">
            <form string="Stop work">
                <sheet>
                    <group>
                        <field name="analytic_line_id" invisible="1" />
                        <field name="name" placeholder="What did you do?" />
                    </group>
                    <footer>
                        <button
                            name="action_stop"
                            string="Stop Work"
                            type="object"
                            class="btn-primary"
                            data-hotkey="q"
                        />
                        <button
                            string="Cancel"
                            special="cancel"
                            data-hotkey="x"
                            class="btn-secondary"
                        />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_timesheet_stop_action" model="ir.actions.act_window">
        <field name="name">Stop Work</field>
        <field name="res_model">hr.timesheet.stop</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
